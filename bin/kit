#!/usr/bin/env bash
# kit — maintain source patches against laravel/react-starter-kit that encode
# Nuno Maduro Essentials recommendations (without requiring nunomaduro/essentials),
# materialize a full-app `kit` branch for `laravel new --using=…`, and create apps.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PATCHES_DIR="${ROOT}/patches"
SERIES_FILE="${PATCHES_DIR}/series"
VERSIONS_FILE="${ROOT}/versions.json"
CACHE_DIR="${KIT_CACHE:-${ROOT}/.cache}"

RED=$'\033[0;31m'
GRN=$'\033[0;32m'
YLW=$'\033[0;33m'
BLU=$'\033[0;34m'
NC=$'\033[0m'

log()  { printf '%s%s%s\n' "${BLU}" "$*" "${NC}" >&2; }
ok()   { printf '%s%s%s\n' "${GRN}" "$*" "${NC}" >&2; }
warn() { printf '%s%s%s\n' "${YLW}" "$*" "${NC}" >&2; }
err()  { printf '%s%s%s\n' "${RED}" "$*" "${NC}" >&2; }

need_cmd() {
  command -v "$1" >/dev/null 2>&1 || { err "Missing required command: $1"; exit 1; }
}

json_get() {
  local file="$1"
  local expr="$2"
  python3 - "$file" "$expr" <<'PY'
import json, sys
data = json.load(open(sys.argv[1]))
print(eval(sys.argv[2], {"data": data}))
PY
}

read_series() {
  [[ -f "$SERIES_FILE" ]] || { err "Missing patch series: $SERIES_FILE"; exit 1; }
  grep -vE '^\s*(#|$)' "$SERIES_FILE"
}

starter_repo() { json_get "$VERSIONS_FILE" 'data["starter_kit"]["repository"]'; }
starter_ref()  { json_get "$VERSIONS_FILE" 'data["starter_kit"]["ref"]'; }
essentials_repo() { json_get "$VERSIONS_FILE" 'data["essentials"]["repository"]'; }
essentials_ref()  { json_get "$VERSIONS_FILE" 'data["essentials"]["ref"]'; }
essentials_commit() { json_get "$VERSIONS_FILE" 'data["essentials"]["commit"]'; }
kit_branch() { json_get "$VERSIONS_FILE" 'data["kit"]["branch"]'; }
kit_composer_name() { json_get "$VERSIONS_FILE" 'data["kit"]["composer_name"]'; }

usage() {
  cat <<EOF
Usage: $(basename "$0") <command> [options]

Commands:
  fetch [--ref <sha|branch|tag>]   Fetch/update the official React starter kit into .cache/
  apply [--dir <path>]             Apply the patch series (to --dir or .cache/starter)
  sync                             Fetch latest upstream main, apply patches, report status
  check-upstreams                  Report whether starter-kit / Essentials moved past pinned refs
  regenerate --dir <patched-tree>  Rebuild patches/* from a working tree vs the pinned upstream
  materialize [--push] [--dir <p>] Build the full-app tree for laravel new --using (kit branch)
  create <name> [--force]          One-command: fetch pinned upstream, apply patches, write ./<name>
  verify [--dir <path>]            Apply to a temp (or given) tree and print a summary
  versions                         Show pinned upstream / kit package metadata
  help                             Show this help

Environment:
  KIT_CACHE   Override cache directory (default: <repo>/.cache)

laravel new --using:
  After materialize --push, consumers use the public kit branch (tiged):

    laravel new my-app --using=https://github.com/arcana-softworks/laravel-react/tree/kit

  See README for the bin/kit create alternative and optional Packagist.

Examples:
  $(basename "$0") materialize --push
  $(basename "$0") create my-app
  $(basename "$0") sync
  $(basename "$0") regenerate --dir /path/to/patched-app
EOF
}

ensure_git_apply() {
  need_cmd git
  need_cmd python3
}

fetch_starter() {
  ensure_git_apply
  local ref="${1:-$(starter_ref)}"
  local dest="${CACHE_DIR}/starter"
  mkdir -p "$CACHE_DIR"

  if [[ -d "${dest}/.git" ]]; then
    log "Updating cached starter kit at ${dest} ..."
    git -C "$dest" fetch --tags origin
    git -C "$dest" checkout --force "$ref"
    git -C "$dest" reset --hard "$ref"
    git -C "$dest" clean -fd
  else
    log "Cloning $(starter_repo) @ ${ref} ..."
    rm -rf "$dest"
    git clone "$(starter_repo)" "$dest"
    git -C "$dest" checkout --force "$ref"
  fi

  local head
  head="$(git -C "$dest" rev-parse HEAD)"
  ok "Starter kit ready: ${head}"
  printf '%s\n' "$head"
}

# Apply a single patch file into $target.
# Prefer `git apply` inside a git work tree (reliable). Fall back to GNU `patch -p1`
# for plain directories — `git apply` outside a repo can exit 0 while skipping hunks.
apply_one_patch() {
  local target="$1"
  local path="$2"
  local patch_name="$3"

  if [[ -d "${target}/.git" ]]; then
    if git -C "$target" apply --check "$path" 2>/tmp/kit-apply.err; then
      git -C "$target" apply "$path"
      return 0
    fi
    return 1
  fi

  need_cmd patch
  # --forward: ignore already-applied; fail on rejects
  if ( cd "$target" && patch -p1 --forward --batch --reject-file=- < "$path" ) > /tmp/kit-apply.err 2>&1; then
    return 0
  fi
  # Some patch versions print "Ignoring" for already-applied and still exit 0/1;
  # treat any .rej or "FAILED" as failure.
  if rg -q "FAILED|rejected|hunk ignored|can't find file" /tmp/kit-apply.err; then
    return 1
  fi
  # If dry evidence of skip-without-change, verify a sentinel for known patches
  return 1
}

apply_patches() {
  ensure_git_apply
  local target="${1:-}"
  if [[ -z "$target" ]]; then
    target="${CACHE_DIR}/starter"
  fi
  target="$(cd "$target" && pwd)"

  [[ -d "$target" ]] || { err "Target directory not found: $target"; exit 1; }
  [[ -f "$target/artisan" ]] || { err "Not a Laravel app (missing artisan): $target"; exit 1; }

  local patch failed=0
  log "Applying patches to ${target} ..."
  while IFS= read -r patch; do
    local path="${PATCHES_DIR}/${patch}"
    [[ -f "$path" ]] || { err "Missing patch file: $path"; exit 1; }

    if apply_one_patch "$target" "$path" "$patch"; then
      ok "  applied ${patch}"
    else
      err "  FAILED ${patch}"
      err "  ---- apply output ----"
      cat /tmp/kit-apply.err >&2 || true
      err "  ----------------------"
      err "  Patch no longer applies cleanly. Update the working tree, then run:"
      err "    $(basename "$0") regenerate --dir <patched-tree>"
      failed=1
      break
    fi
  done < <(read_series)

  if [[ "$failed" -ne 0 ]]; then
    return 1
  fi

  # Sanity: Essentials runtime patch must leave a detectable marker
  if ! rg -q "Model::shouldBeStrict" "${target}/app/Providers/AppServiceProvider.php"; then
    err "Patches reported OK but AppServiceProvider is missing Model::shouldBeStrict — apply was skipped."
    err "Ensure the target is a git work tree or that GNU patch applied hunks."
    return 1
  fi

  ok "All patches applied successfully."
  return 0
}

rewrite_kit_composer_json() {
  local dir="$1"
  local name="$2"
  local starter_sha="$3"
  local essentials_ref="$4"
  python3 - "$dir/composer.json" "$name" "$starter_sha" "$essentials_ref" <<'PY'
import json, sys
path, name, starter_sha, essentials_ref = sys.argv[1:5]
data = json.load(open(path))
data["name"] = name
data["description"] = (
    "Generated full-app tree: official laravel/react-starter-kit "
    f"({starter_sha[:12]}) + Essentials recommendation patches "
    f"(mapped from nunomaduro/essentials {essentials_ref}; package not required). "
    "Do not hand-edit — regenerate with bin/kit materialize."
)
# Keep type=project for composer create-project / laravel new --using
data["type"] = "project"
json.dump(data, open(path, "w"), indent=4)
open(path, "a").write("\n")
print(f"composer.json name -> {name}")
PY
}

# Build a clean full-app tree (no meta-repo files). Never run composer install here:
# laravel new / create-project owns dependency install + deferred Chisel hooks.
materialize_tree() {
  ensure_git_apply
  need_cmd rsync
  local dest="${1:-${CACHE_DIR}/materialized}"
  local pin
  pin="$(starter_ref)"
  local pkg
  pkg="$(kit_composer_name)"

  log "Materializing full-app kit from $(starter_repo)@${pin} + patches ..."
  # Apply on the cached git checkout (git apply is reliable with .git present),
  # then copy the patched tree without .git into the materialize destination.
  fetch_starter "$pin" >/dev/null
  apply_patches "${CACHE_DIR}/starter"

  rm -rf "$dest"
  mkdir -p "$dest"
  rsync -a --exclude '.git' "${CACHE_DIR}/starter/" "${dest}/"
  rewrite_kit_composer_json "$dest" "$pkg" "$pin" "$(essentials_ref)"

  # Marker so consumers/CI can tell this tree is generated
  cat > "${dest}/.kit-generated" <<EOF
generated_by=bin/kit materialize
starter_kit_ref=${pin}
essentials_ref=$(essentials_ref)
essentials_commit=$(essentials_commit)
composer_name=${pkg}
kit_branch=$(kit_branch)
do_not_hand_edit=1
EOF

  ok "Materialized at ${dest}"
  # Path is also written for callers that cannot capture mixed log+path stdout.
  printf '%s' "$dest" > "${CACHE_DIR}/last-materialized.path"
  printf '%s\n' "$dest"
}

push_kit_branch() {
  ensure_git_apply
  need_cmd rsync
  local src="$1"
  local branch
  branch="$(kit_branch)"
  local work="${CACHE_DIR}/kit-branch-git"
  local remote_url
  remote_url="$(git -C "$ROOT" remote get-url origin 2>/dev/null || true)"
  [[ -n "$remote_url" ]] || { err "No git remote 'origin' — cannot push ${branch}"; exit 1; }

  log "Publishing orphan branch '${branch}' to origin (generated tree only) ..."
  rm -rf "$work"
  mkdir -p "$work"
  rsync -a --exclude '.git' "${src}/" "${work}/"
  git -C "$work" init -q
  git -C "$work" checkout -B "$branch"
  git -C "$work" add -A
  local starter_sha essentials_sha pkg
  starter_sha="$(starter_ref)"
  essentials_sha="$(essentials_commit)"
  pkg="$(kit_composer_name)"
  git -C "$work" -c user.email=kit@local -c user.name=kit \
    commit -q -m "materialize ${pkg} from react-starter-kit@${starter_sha:0:12} + Essentials ${essentials_sha:0:12} patches"

  git -C "$work" remote add origin "$remote_url"
  git -C "$work" push -u --force origin "HEAD:refs/heads/${branch}"
  ok "Pushed origin/${branch}"
  ok "Composer version for this branch: dev-${branch}"
}

check_upstreams() {
  ensure_git_apply
  mkdir -p "$CACHE_DIR"

  local starter_pin essentials_pin
  starter_pin="$(starter_ref)"
  essentials_pin="$(essentials_commit)"

  log "Checking laravel/react-starter-kit ..."
  local starter_remote
  starter_remote="$(git ls-remote "$(starter_repo)" refs/heads/main | awk '{print $1}')"
  if [[ -z "$starter_remote" ]]; then
    err "Could not resolve starter kit main SHA"
    return 1
  fi

  log "Checking nunomaduro/essentials ..."
  local essentials_remote essentials_latest_tag essentials_tag_sha=""
  essentials_remote="$(git ls-remote "$(essentials_repo)" refs/heads/main | awk '{print $1}')"
  essentials_latest_tag="$(git ls-remote --tags --refs "$(essentials_repo)" 'v*' | awk '{print $2}' | sed 's#refs/tags/##' | sort -V | tail -1)"
  if [[ -n "$essentials_latest_tag" ]]; then
    essentials_tag_sha="$(git ls-remote --tags --refs "$(essentials_repo)" "refs/tags/${essentials_latest_tag}" | awk '{print $1}')"
  fi

  local status=0
  echo
  echo "Pinned starter kit:     ${starter_pin}"
  echo "Remote main:            ${starter_remote}"
  if [[ "$starter_pin" == "$starter_remote" ]]; then
    ok "Starter kit: up to date with origin/main"
  else
    warn "Starter kit: origin/main has moved — re-run sync and fix patches if needed"
    status=1
  fi

  echo
  echo "Pinned Essentials:      $(essentials_ref) (${essentials_pin})"
  echo "Remote main:            ${essentials_remote}"
  echo "Latest tag:             ${essentials_latest_tag:-unknown} (${essentials_tag_sha:-unknown})"
  if [[ -n "$essentials_tag_sha" && "$essentials_pin" == "$essentials_tag_sha" ]]; then
    ok "Essentials: pin matches latest release tag (${essentials_latest_tag})"
  elif [[ -n "$essentials_tag_sha" && "$essentials_pin" != "$essentials_tag_sha" ]]; then
    warn "Essentials: a newer tag exists (${essentials_latest_tag}). Review docs/ESSENTIALS_MAPPING.md and update patches."
    status=1
  else
    warn "Essentials: could not resolve latest tag SHA"
    status=1
  fi

  if [[ -n "$essentials_remote" && "$essentials_pin" != "$essentials_remote" ]]; then
    local ess_tmp="${CACHE_DIR}/essentials-compare"
    rm -rf "$ess_tmp"
    git clone --quiet "$(essentials_repo)" "$ess_tmp"
    if ! git -C "$ess_tmp" diff --quiet "${essentials_pin}..${essentials_remote}" -- src config stubs; then
      warn "Essentials: origin/main changed src/config/stubs vs pin — review mapping"
      status=1
    else
      ok "Essentials: origin/main has no src/config/stubs changes vs pin (docs/CI-only drift OK)"
    fi
  fi

  return "$status"
}

cmd_sync() {
  ensure_git_apply
  local remote_sha
  remote_sha="$(git ls-remote "$(starter_repo)" refs/heads/main | awk '{print $1}')"
  [[ -n "$remote_sha" ]] || { err "Unable to resolve upstream main"; exit 1; }

  log "Sync: fetching starter kit main (${remote_sha}) ..."
  fetch_starter "$remote_sha" >/dev/null
  printf '%s\n' "$remote_sha" > "${CACHE_DIR}/last-sync-starter.sha"

  if ! apply_patches "${CACHE_DIR}/starter"; then
    err "Sync failed: patches did not apply to ${remote_sha}"
    check_upstreams || true
    exit 2
  fi

  ok "Sync apply succeeded against ${remote_sha}"
  if check_upstreams; then
    ok "Upstream pins are current."
  else
    warn "Patches applied, but upstream pins are behind — consider regenerating against new Essentials defaults."
  fi
}

cmd_regenerate() {
  ensure_git_apply
  need_cmd rsync
  local dir=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dir) dir="$2"; shift 2 ;;
      *) err "Unknown argument: $1"; usage; exit 1 ;;
    esac
  done
  [[ -n "$dir" ]] || { err "regenerate requires --dir <patched-tree>"; exit 1; }
  dir="$(cd "$dir" && pwd)"

  local pin
  pin="$(starter_ref)"
  log "Regenerating patches from ${dir} against pinned upstream ${pin} ..."

  local base="${CACHE_DIR}/regenerate-base"
  rm -rf "$base"
  git clone "$(starter_repo)" "$base"
  git -C "$base" checkout --force "$pin"
  git -C "$base" reset --hard "$pin"

  local work="${CACHE_DIR}/regenerate-work"
  rm -rf "$work"
  mkdir -p "$work"
  rsync -a --delete \
    --exclude '.git' \
    --exclude 'vendor' \
    --exclude 'node_modules' \
    --exclude 'public/build' \
    --exclude '.env' \
    --exclude 'database/*.sqlite' \
    --exclude 'storage/logs/*' \
    --exclude 'storage/framework/cache/data/*' \
    --exclude 'bootstrap/cache/*.php' \
    --exclude 'composer.lock' \
    --exclude 'package-lock.json' \
    --exclude '.kit-generated' \
    "${base}/" "${work}/"

  git -C "$work" init -q
  git -C "$work" add -A
  git -C "$work" -c user.email=kit@local -c user.name=kit commit -q -m 'upstream base'

  rsync -a --delete \
    --exclude '.git' \
    --exclude 'vendor' \
    --exclude 'node_modules' \
    --exclude 'public/build' \
    --exclude '.env' \
    --exclude 'database/*.sqlite' \
    --exclude 'storage/logs/*' \
    --exclude 'storage/framework/cache/data/*' \
    --exclude 'bootstrap/cache/*.php' \
    --exclude 'composer.lock' \
    --exclude 'package-lock.json' \
    --exclude '.kit-generated' \
    "${dir}/" "${work}/"

  # If materialize rewrote composer.json name, restore upstream name before diffing
  # so patches stay relative to official starter kit (single source of truth).
  if [[ -f "${base}/composer.json" ]]; then
    python3 - "${base}/composer.json" "${work}/composer.json" <<'PY'
import json, sys
base, work = sys.argv[1:3]
b = json.load(open(base))
w = json.load(open(work))
w["name"] = b["name"]
w["description"] = b.get("description", w.get("description", ""))
json.dump(w, open(work, "w"), indent=4)
open(work, "a").write("\n")
PY
  fi

  git -C "$work" add -A

  local runtime=(app/Providers/AppServiceProvider.php)
  local tooling=(pint.json rector.php app/Console/Commands/MakeActionCommand.php stubs/action.stub)

  mkdir -p "$PATCHES_DIR"
  git -C "$work" diff --cached -- "${runtime[@]}" > "${PATCHES_DIR}/0001-essentials-runtime-defaults.patch"
  git -C "$work" diff --cached -- "${tooling[@]}" > "${PATCHES_DIR}/0002-essentials-tooling-and-make-action.patch"

  mapfile -t all_files < <(git -C "$work" diff --cached --name-only)
  local rest=()
  local f
  for f in "${all_files[@]}"; do
    local skip=0
    local x
    for x in "${runtime[@]}" "${tooling[@]}"; do
      if [[ "$f" == "$x" ]]; then skip=1; break; fi
    done
    if [[ "$skip" -eq 0 ]]; then
      rest+=("$f")
    fi
  done

  if [[ "${#rest[@]}" -gt 0 ]]; then
    git -C "$work" diff --cached -- "${rest[@]}" > "${PATCHES_DIR}/0003-essentials-code-style-and-types.patch"
  else
    : > "${PATCHES_DIR}/0003-essentials-code-style-and-types.patch"
  fi

  cat > "$SERIES_FILE" <<EOF
0001-essentials-runtime-defaults.patch
0002-essentials-tooling-and-make-action.patch
0003-essentials-code-style-and-types.patch
EOF

  ok "Wrote patch series:"
  cat "$SERIES_FILE"
  warn "Remember to update versions.json if you changed the upstream pin or Essentials mapping."
}

cmd_materialize() {
  local push=0 dest=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --push) push=1; shift ;;
      --dir) dest="$2"; shift 2 ;;
      *) err "Unknown argument: $1"; exit 1 ;;
    esac
  done

  materialize_tree "${dest:-${CACHE_DIR}/materialized}" >/dev/null
  local out
  out="$(cat "${CACHE_DIR}/last-materialized.path")"
  [[ -n "$out" && -d "$out" ]] || { err "materialize failed to produce a tree"; exit 1; }
  if [[ "$push" -eq 1 ]]; then
    push_kit_branch "$out"
  else
    warn "Tree ready at ${out}. Pass --push to publish origin/$(kit_branch)."
  fi
}

cmd_create() {
  ensure_git_apply
  need_cmd rsync
  local name="" force=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force|-f) force=1; shift ;;
      -*) err "Unknown option: $1"; exit 1 ;;
      *) name="$1"; shift ;;
    esac
  done
  [[ -n "$name" ]] || { err "create requires an application name"; usage; exit 1; }

  local dest="${PWD}/${name}"
  if [[ -e "$dest" ]]; then
    if [[ "$force" -eq 1 ]]; then
      warn "Removing existing ${dest}"
      rm -rf "$dest"
    else
      err "Directory exists: ${dest} (pass --force to replace)"
      exit 1
    fi
  fi

  local pin
  pin="$(starter_ref)"
  log "Creating ${name} from laravel/react-starter-kit@${pin} + patches ..."

  fetch_starter "$pin" >/dev/null
  apply_patches "${CACHE_DIR}/starter"
  mkdir -p "$dest"
  rsync -a --exclude '.git' "${CACHE_DIR}/starter/" "${dest}/"
  rm -rf "${dest}/.cache" 2>/dev/null || true

  ok "Created ${dest}"
  cat <<EOF

Next steps:
  cd ${name}
  composer install --no-interaction --prefer-dist
  # Prefer laravel new --using=… for full installer/Chisel hook behaviour.

  Or use the materialized kit branch (tiged):
    laravel new ${name} --using=https://github.com/arcana-softworks/laravel-react/tree/kit
EOF
}

cmd_verify() {
  local dir=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dir) dir="$2"; shift 2 ;;
      *) err "Unknown argument: $1"; exit 1 ;;
    esac
  done

  if [[ -z "$dir" ]]; then
    fetch_starter "$(starter_ref)" >/dev/null
    dir="${CACHE_DIR}/starter"
    git -C "$dir" reset --hard "$(starter_ref)"
    git -C "$dir" clean -fd
  fi

  apply_patches "$dir"
  ok "Verify OK on ${dir}"
  echo "Pinned starter:    $(starter_ref)"
  echo "Pinned essentials: $(essentials_ref) ($(essentials_commit))"
  echo "Kit using URL:     https://github.com/arcana-softworks/laravel-react/tree/$(kit_branch)"
  echo "Kit package (opt): $(kit_composer_name) (branch $(kit_branch) => dev-$(kit_branch))"
}

cmd_versions() {
  python3 - "$VERSIONS_FILE" <<'PY'
import json, sys
print(json.dumps(json.load(open(sys.argv[1])), indent=2))
PY
}

main() {
  local cmd="${1:-help}"
  shift || true
  case "$cmd" in
    fetch)
      local ref=""
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --ref) ref="$2"; shift 2 ;;
          *) err "Unknown argument: $1"; exit 1 ;;
        esac
      done
      fetch_starter "${ref:-$(starter_ref)}"
      ;;
    apply)
      local dir=""
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --dir) dir="$2"; shift 2 ;;
          *) err "Unknown argument: $1"; exit 1 ;;
        esac
      done
      if [[ -z "$dir" ]]; then
        fetch_starter "$(starter_ref)" >/dev/null
        dir="${CACHE_DIR}/starter"
      fi
      apply_patches "$dir"
      ;;
    sync) cmd_sync "$@" ;;
    check-upstreams) check_upstreams "$@" ;;
    regenerate) cmd_regenerate "$@" ;;
    materialize) cmd_materialize "$@" ;;
    create) cmd_create "$@" ;;
    verify) cmd_verify "$@" ;;
    versions) cmd_versions "$@" ;;
    help|-h|--help) usage ;;
    *) err "Unknown command: $cmd"; usage; exit 1 ;;
  esac
}

main "$@"
