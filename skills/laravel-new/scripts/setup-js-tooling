#!/usr/bin/env bash
# setup-js-tooling — JS format/lint/types/tests via vite-plus (`vp`) when the
# kit ships it; otherwise fall back to direct oxfmt/oxlint + Vitest.
#
# Usage:
#   setup-js-tooling [--dir <app>]
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REF_JS="${SCRIPT_DIR}/../reference/js"

APP_DIR="$(pwd)"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --dir) APP_DIR="$2"; shift 2 ;;
    -h|--help) sed -n '2,8p' "$0"; exit 0 ;;
    *) echo "Unknown arg: $1" >&2; exit 1 ;;
  esac
done

APP_DIR="$(cd "$APP_DIR" && pwd)"
cd "$APP_DIR"

RED=$'\033[0;31m'; GRN=$'\033[0;32m'; YLW=$'\033[0;33m'; BLU=$'\033[0;34m'; NC=$'\033[0m'
log()  { printf '%s%s%s\n' "$BLU" "$*" "$NC" >&2; }
ok()   { printf '%s%s%s\n' "$GRN" "$*" "$NC" >&2; }
warn() { printf '%s%s%s\n' "$YLW" "$*" "$NC" >&2; }

[[ -f package.json ]] || { warn "No package.json — skipping JS tooling"; exit 0; }

detect_frontend() {
  python3 <<'PY'
import json
data = json.load(open("package.json"))
deps = {**data.get("dependencies", {}), **data.get("devDependencies", {})}
if any(k == "react" or k.startswith("@inertiajs/react") for k in deps):
    print("react")
elif any(k == "vue" or k.startswith("@inertiajs/vue") or k.startswith("vue") for k in deps):
    print("vue")
elif any("svelte" in k for k in deps):
    print("svelte")
else:
    print("generic")
PY
}

has_dep() {
  python3 - "$1" <<'PY'
import json, sys
name = sys.argv[1]
data = json.load(open("package.json"))
deps = {**data.get("dependencies", {}), **data.get("devDependencies", {})}
raise SystemExit(0 if name in deps else 1)
PY
}

npm_uninstall() {
  local -a pkgs=("$@")
  [[ ${#pkgs[@]} -eq 0 || -z "${pkgs[0]:-}" ]] && return 0
  npm uninstall "${pkgs[@]}" || warn "npm uninstall reported issues"
}

npm_install_dev() {
  npm install -D "$@"
}

FRONTEND="$(detect_frontend)"
log "Detected frontend stack: ${FRONTEND}"

HAS_VITE_PLUS=0
has_dep "vite-plus" && HAS_VITE_PLUS=1

# --- Remove Prettier / ESLint / Jest leftovers ---
python3 <<'PY' > /tmp/js-old-pkgs.txt
import json
data = json.load(open("package.json"))
deps = {**data.get("dependencies", {}), **data.get("devDependencies", {})}
drop = []
for name in deps:
    if (
        name in {
            "prettier",
            "eslint",
            "jest",
            "@swc/jest",
            "@swc/core",
            "jest-environment-jsdom",
            "@types/jest",
            "identity-obj-proxy",
        }
        or name.startswith("prettier-")
        or name.startswith("eslint-")
        or name.startswith("@typescript-eslint/")
        or name.startswith("@prettier/")
        or name.startswith("eslint-plugin-")
        or name.startswith("eslint-config-")
        or name.startswith("eslint-formatter-")
        or name.startswith("@jest/")
    ):
        drop.append(name)
print("\n".join(sorted(set(drop))))
PY
mapfile -t OLD_PKGS < /tmp/js-old-pkgs.txt || true
if [[ ${#OLD_PKGS[@]} -gt 0 && -n "${OLD_PKGS[0]:-}" ]]; then
  log "Removing old JS lint/format/Jest packages: ${OLD_PKGS[*]}"
  npm_uninstall "${OLD_PKGS[@]}"
fi

for f in \
  .prettierrc .prettierrc.js .prettierrc.cjs .prettierrc.mjs .prettierrc.json .prettierrc.yaml .prettierrc.yml \
  prettier.config.js prettier.config.cjs prettier.config.mjs prettier.config.ts \
  .prettierignore \
  .eslintrc .eslintrc.js .eslintrc.cjs .eslintrc.json .eslintrc.yml \
  eslint.config.js eslint.config.mjs eslint.config.cjs eslint.config.ts \
  .eslintignore \
  jest.config.js jest.config.cjs jest.config.mjs jest.config.ts \
  resources/js/jest.setup.ts
 do
  [[ -e "$f" ]] && rm -f "$f" && log "Removed ${f}"
done

# Support packages for Vitest smoke (jsdom + Testing Library). Always needed.
TEST_PKGS=(jsdom)
case "$FRONTEND" in
  react)
    TEST_PKGS+=(@testing-library/react @testing-library/jest-dom @testing-library/dom @testing-library/user-event)
    ;;
  vue)
    TEST_PKGS+=(@testing-library/vue @testing-library/jest-dom @testing-library/dom @vue/test-utils)
    ;;
  svelte)
    TEST_PKGS+=(@testing-library/svelte @testing-library/jest-dom @testing-library/dom)
    ;;
  *)
    TEST_PKGS+=(@testing-library/dom @testing-library/jest-dom)
    ;;
esac

# React kits using @rolldown/plugin-babel need @babel/core as a peer for vp build/test.
if has_dep "@rolldown/plugin-babel" && ! has_dep "@babel/core"; then
  TEST_PKGS+=(@babel/core)
fi

mkdir -p resources/js resources/js/__tests__
cp "${REF_JS}/vitest.setup.ts" resources/js/vitest.setup.ts

ensure_vite_plus_config() {
  # Ensure lint.options.typeAware + typeCheck, and a Vitest test block, in vite.config.*.
  # Prefer kit fmt/lint blocks; do not write separate .oxfmtrc / .oxlintrc.
  python3 <<'PY'
from pathlib import Path
import re

candidates = [Path(p) for p in ("vite.config.ts", "vite.config.js", "vite.config.mts", "vite.config.mjs")]
path = next((p for p in candidates if p.is_file()), None)
if path is None:
    raise SystemExit("vite-plus present but no vite.config.* found")

text = path.read_text(encoding="utf-8")

# Ensure typeCheck: true alongside typeAware in lint.options
if re.search(r"\blint\s*:", text):
    if re.search(r"typeCheck\s*:\s*true", text):
        print(f"{path}: lint.options.typeCheck already true")
    elif re.search(r"typeAware\s*:\s*true", text):
        text2, n = re.subn(
            r"(typeAware\s*:\s*true)(\s*,?)",
            r"\1,\n            typeCheck: true\2",
            text,
            count=1,
        )
        if n == 0:
            raise SystemExit(f"Could not enable typeCheck in {path}")
        text = text2
        print(f"{path}: enabled lint.options.typeCheck")
    else:
        # Insert options block or augment existing options
        if re.search(r"lint\s*:\s*\{[^}]*options\s*:", text, flags=re.S):
            text2, n = re.subn(
                r"(lint\s*:\s*\{.*?options\s*:\s*\{)",
                r"\1\n            typeAware: true,\n            typeCheck: true,",
                text,
                count=1,
                flags=re.S,
            )
            if n == 0:
                raise SystemExit(f"Could not augment lint.options in {path}")
            text = text2
        else:
            text2, n = re.subn(
                r"(lint\s*:\s*\{)",
                r"\1\n        options: {\n            typeAware: true,\n            typeCheck: true,\n        },",
                text,
                count=1,
            )
            if n == 0:
                raise SystemExit(f"Could not add lint.options in {path}")
            text = text2
        print(f"{path}: added lint.options typeAware+typeCheck")
else:
    block = """    lint: {
        options: {
            typeAware: true,
            typeCheck: true,
        },
    },
"""
    text2, n = re.subn(r"(\n)(\}\);?\s*)$", r"\1" + block + r"\2", text, count=1, flags=re.M)
    if n == 0:
        raise SystemExit(f"Could not add lint block to {path}")
    text = text2
    print(f"{path}: added lint block")

# Ensure Vitest test block
if re.search(r"\btest\s*:", text):
    # Ensure setupFiles if missing
    if "vitest.setup.ts" not in text:
        text2, n = re.subn(
            r"(\btest\s*:\s*\{)",
            r"\1\n        setupFiles: ['resources/js/vitest.setup.ts'],",
            text,
            count=1,
        )
        if n:
            text = text2
            print(f"{path}: added test.setupFiles")
        else:
            print(f"{path}: test block present (left unchanged)")
    else:
        print(f"{path}: test block already present")
else:
    block = """    test: {
        environment: 'jsdom',
        include: ['resources/js/**/*.{test,spec}.{js,jsx,ts,tsx}'],
        setupFiles: ['resources/js/vitest.setup.ts'],
    },
"""
    text2, n = re.subn(r"(\n)(\}\);?\s*)$", r"\1" + block + r"\2", text, count=1, flags=re.M)
    if n == 0:
        raise SystemExit(f"Could not insert Vitest test block into {path}")
    text = text2
    print(f"{path}: added Vitest test block")

path.write_text(text, encoding="utf-8")
PY
}

if [[ "$HAS_VITE_PLUS" -eq 1 ]]; then
  log "vite-plus detected — routing format/lint/types/test/build through vp"

  # Drop direct ox* deps if a previous skill run added them; vite-plus already bundles them.
  python3 <<'PY' > /tmp/js-ox-pkgs.txt
import json
data = json.load(open("package.json"))
deps = {**data.get("dependencies", {}), **data.get("devDependencies", {})}
drop = [n for n in deps if n in {"oxfmt", "oxlint", "oxlint-tsgolint"}]
print("\n".join(sorted(drop)))
PY
  mapfile -t OX_PKGS < /tmp/js-ox-pkgs.txt || true
  if [[ ${#OX_PKGS[@]} -gt 0 && -n "${OX_PKGS[0]:-}" ]]; then
    log "Removing direct ox* packages (provided by vite-plus): ${OX_PKGS[*]}"
    npm_uninstall "${OX_PKGS[@]}"
  fi

  for f in .oxfmtrc.json .oxfmtrc .oxlintrc.json .oxlintrc oxlint.config.ts oxlint.config.js; do
    [[ -e "$f" ]] && rm -f "$f" && log "Removed ${f} (use vite.config lint/fmt instead)"
  done

  ensure_vite_plus_config

  log "Installing Vitest support packages: ${TEST_PKGS[*]}"
  npm_install_dev "${TEST_PKGS[@]}"

  case "$FRONTEND" in
    react) cp "${REF_JS}/smoke.test.tsx" resources/js/__tests__/smoke.test.tsx ;;
    *) cp "${REF_JS}/smoke.test.ts" resources/js/__tests__/smoke.test.ts ;;
  esac

  FORMAT_CMD="vp fmt"
  FORMAT_CHECK_CMD="vp fmt --check"
  LINT_CMD="vp lint"
  # Type-check only via vp check (requires lint.options.typeCheck).
  TYPES_CMD="vp check --no-fmt --no-lint"
  TEST_CMD="vp test"
  # Keep build on vp when the kit already uses it; ensure script exists.
  BUILD_CMD="vp build"

else
  log "No vite-plus — falling back to direct oxfmt/oxlint + Vitest"

  log "Installing oxfmt, oxlint, oxlint-tsgolint..."
  npm_install_dev oxfmt oxlint oxlint-tsgolint

  cp "${REF_JS}/.oxfmtrc.json" .oxfmtrc.json
  case "$FRONTEND" in
    react)
      cp "${REF_JS}/.oxlintrc.json" .oxlintrc.json
      ;;
    *)
      python3 - "${REF_JS}/.oxlintrc.json" <<'PY'
import json, sys
cfg = json.load(open(sys.argv[1]))
cfg["plugins"] = [p for p in cfg.get("plugins", []) if p != "react"]
json.dump(cfg, open(".oxlintrc.json", "w"), indent=2)
open(".oxlintrc.json", "a").write("\n")
PY
      ;;
  esac

  if ! has_dep "vitest"; then
    TEST_PKGS+=(vitest)
  fi

  log "Installing Vitest support packages: ${TEST_PKGS[*]}"
  npm_install_dev "${TEST_PKGS[@]}"

  HAS_VITE_CONFIG=0
  for cfg in vite.config.ts vite.config.js vite.config.mts vite.config.mjs; do
    [[ -f "$cfg" ]] && HAS_VITE_CONFIG=1 && break
  done

  if [[ "$HAS_VITE_CONFIG" -eq 1 ]]; then
    python3 <<'PY'
from pathlib import Path
import re
candidates = [Path(p) for p in ("vite.config.ts", "vite.config.js", "vite.config.mts", "vite.config.mjs")]
path = next(p for p in candidates if p.is_file())
text = path.read_text(encoding="utf-8")
if re.search(r"\btest\s*:", text):
    print(f"{path}: test block already present")
else:
    block = """    test: {
        environment: 'jsdom',
        include: ['resources/js/**/*.{test,spec}.{js,jsx,ts,tsx}'],
        setupFiles: ['resources/js/vitest.setup.ts'],
    },
"""
    text2, n = re.subn(r"(\n)(\}\);?\s*)$", r"\1" + block + r"\2", text, count=1, flags=re.M)
    if n == 0:
        raise SystemExit(f"Could not insert Vitest test block into {path}")
    path.write_text(text2, encoding="utf-8")
    print(f"{path}: added Vitest test block")
PY
  else
    log "Adding standalone vitest.config.ts"
    cp "${REF_JS}/vitest.config.ts" vitest.config.ts
  fi

  case "$FRONTEND" in
    react)
      python3 - "${REF_JS}/smoke.test.tsx" <<'PY'
from pathlib import Path
import sys
src = Path(sys.argv[1]).read_text(encoding="utf-8").replace("vite-plus/test", "vitest")
Path("resources/js/__tests__/smoke.test.tsx").write_text(src, encoding="utf-8")
PY
      ;;
    *)
      python3 - "${REF_JS}/smoke.test.ts" <<'PY'
from pathlib import Path
import sys
src = Path(sys.argv[1]).read_text(encoding="utf-8").replace("vite-plus/test", "vitest")
Path("resources/js/__tests__/smoke.test.ts").write_text(src, encoding="utf-8")
PY
      ;;
  esac

  FORMAT_CMD="oxfmt"
  FORMAT_CHECK_CMD="oxfmt --check"
  LINT_CMD="oxlint"
  TYPES_CMD="oxlint --type-aware --type-check"
  TEST_CMD="vitest run"
  BUILD_CMD=""
fi

# --- package.json scripts ---
python3 - "$FORMAT_CMD" "$FORMAT_CHECK_CMD" "$LINT_CMD" "$TYPES_CMD" "$TEST_CMD" "$BUILD_CMD" <<'PY'
import json
import sys
from pathlib import Path

format_cmd, format_check_cmd, lint_cmd, types_cmd, test_cmd, build_cmd = sys.argv[1:7]
path = Path("package.json")
data = json.loads(path.read_text())
scripts = data.setdefault("scripts", {})

scripts["format"] = format_cmd
scripts["format:check"] = format_check_cmd
scripts["lint"] = lint_cmd
scripts["types"] = types_cmd
scripts["test:js"] = test_cmd
if build_cmd and "build" not in scripts:
    scripts["build"] = build_cmd

# Retire Prettier/ESLint/Jest/tsc aliases only — keep kit `vp check` scripts.
for dead in ("check:format", "lint:fix", "format:fix", "types:check", "typecheck", "test:unit"):
    if dead not in scripts:
        continue
    val = scripts[dead]
    if any(tok in val for tok in ("prettier", "eslint", "tsc --noEmit", "jest")):
        scripts.pop(dead, None)

# Drop legacy `check` only when it is prettier/eslint-based, not when it is already vp check.
if "check" in scripts:
    val = scripts["check"]
    if any(tok in val for tok in ("prettier", "eslint")) and "vp " not in val:
        scripts.pop("check", None)

if scripts.get("types:check", "").startswith("tsc"):
    scripts.pop("types:check", None)

path.write_text(json.dumps(data, indent=4) + "\n")
keys = ("format", "format:check", "lint", "types", "test:js", "build")
print("Updated package.json scripts:", {k: scripts[k] for k in keys if k in scripts})
PY

# Format once so format:check is green for the tooling commit.
log "Running format (write)..."
if [[ "$HAS_VITE_PLUS" -eq 1 ]]; then
  npx vp fmt || warn "vp fmt reported issues"
else
  npx oxfmt || warn "oxfmt write reported issues"
fi

ok "JS tooling ready ($([ "$HAS_VITE_PLUS" -eq 1 ] && echo 'vite-plus vp' || echo 'oxfmt/oxlint + Vitest'))"
echo "Frontend=${FRONTEND}"
echo "VitePlus=${HAS_VITE_PLUS}"
echo "TestCmd=${TEST_CMD}"
