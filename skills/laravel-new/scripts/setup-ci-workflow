#!/usr/bin/env bash
# setup-ci-workflow — write .github/workflows/ci.yml for the generated app.
# Detects installed PHP/JS tooling and the package manager; only emits
# check / dry-run steps (never write or auto-fix).
#
# Usage:
#   setup-ci-workflow [--dir <app>]
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/package-manager.sh
source "${SCRIPT_DIR}/lib/package-manager.sh"

APP_DIR="$(pwd)"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --dir) APP_DIR="$2"; shift 2 ;;
    -h|--help) sed -n '2,8p' "$0"; exit 0 ;;
    *) echo "Unknown arg: $1" >&2; exit 1 ;;
  esac
done

APP_DIR="$(cd "$APP_DIR" && pwd)"
cd "$APP_DIR"

RED=$'\033[0;31m'; GRN=$'\033[0;32m'; YLW=$'\033[0;33m'; BLU=$'\033[0;34m'; NC=$'\033[0m'
log()  { printf '%s%s%s\n' "$BLU" "$*" "$NC" >&2; }
ok()   { printf '%s%s%s\n' "$GRN" "$*" "$NC" >&2; }
warn() { printf '%s%s%s\n' "$YLW" "$*" "$NC" >&2; }

[[ -f artisan ]] || { printf '%s%s%s\n' "$RED" "Not a Laravel app: ${APP_DIR}" "$NC" >&2; exit 1; }

resolve_package_manager
log "Generating CI workflow (package manager: ${PM})"

python3 - "$PM" <<'PY'
from __future__ import annotations

import json
import re
import sys
from pathlib import Path

pm = sys.argv[1]
root = Path(".")

composer = json.loads((root / "composer.json").read_text(encoding="utf-8")) if (root / "composer.json").is_file() else {}
pkg_path = root / "package.json"
package = json.loads(pkg_path.read_text(encoding="utf-8")) if pkg_path.is_file() else None
scripts = (package or {}).get("scripts") or {}
composer_req = {**(composer.get("require") or {}), **(composer.get("require-dev") or {})}

def php_version() -> str:
    raw = str((composer.get("require") or {}).get("php", "8.3"))
    m = re.search(r"(\d+\.\d+)", raw)
    return m.group(1) if m else "8.3"

def node_version() -> str:
    engines = (package or {}).get("engines") or {}
    raw = str(engines.get("node", "22"))
    m = re.search(r"(\d+)", raw)
    return m.group(1) if m else "22"

php_ver = php_version()
node_ver = node_version()

has_pint = (root / "vendor/bin/pint").exists() or "laravel/pint" in composer_req
has_phpstan = (
    (root / "vendor/bin/phpstan").exists()
    or "larastan/larastan" in composer_req
    or "phpstan/phpstan" in composer_req
    or (root / "phpstan.neon").is_file()
    or (root / "phpstan.neon.dist").is_file()
)
has_rector = (root / "vendor/bin/rector").exists() or "rector/rector" in composer_req
# Only enable Rector dry-run when both binary/package and config exist.
has_rector = has_rector and ((root / "rector.php").is_file() or (root / "rector.php.dist").is_file())

has_js = package is not None
has_format_check = has_js and "format:check" in scripts
has_lint = has_js and "lint" in scripts
has_types = has_js and "types" in scripts
has_test_js = has_js and "test:js" in scripts
has_build = has_js and "build" in scripts
js_deps = {
    **((package or {}).get("dependencies") or {}),
    **((package or {}).get("devDependencies") or {}),
}
# Vite/Wayfinder builds need PHP available in the JS job.
needs_php_for_js = has_js and (
    has_build
    or (root / "vite.config.ts").is_file()
    or (root / "vite.config.js").is_file()
    or "laravel-vite-plugin" in js_deps
)

# Frontend feature tests usually need a production Vite build.
php_needs_assets = has_js and has_build

if pm == "npm":
    pm_install = "npm ci"
    cache_input = "npm"
    lockfile = "package-lock.json"
elif pm == "pnpm":
    pm_install = "pnpm install --frozen-lockfile"
    cache_input = "pnpm"
    lockfile = "pnpm-lock.yaml"
elif pm == "yarn":
    pm_install = "yarn install --frozen-lockfile"
    cache_input = "yarn"
    lockfile = "yarn.lock"
else:  # bun
    pm_install = "bun install --frozen-lockfile"
    cache_input = ""  # setup-node has no bun cache input
    lockfile = "bun.lockb"

lines: list[str] = []
def w(s: str = "") -> None:
    lines.append(s)

w("name: ci")
w()
w("# Generated by laravel-new setup-ci-workflow — check/dry-run only (no write/fix).")
w("on:")
w("  push:")
w("    branches: [main]")
w("  pull_request:")
w()
w("permissions:")
w("  contents: read")
w()
w("concurrency:")
w("  group: ci-${{ github.workflow }}-${{ github.ref }}")
w("  cancel-in-progress: true")
w()
w("jobs:")

# ---------- PHP job ----------
w("  php:")
w("    name: php")
w("    runs-on: ubuntu-latest")
w("    timeout-minutes: 30")
w()
w("    steps:")
w("      - uses: actions/checkout@v5")
w()
w("      - uses: shivammathur/setup-php@2.40.0")
w("        with:")
w(f"          php-version: '{php_ver}'")
w("          extensions: mbstring, xml, curl, zip, sqlite3, bcmath, intl")
w("          coverage: none")
w("          tools: composer:v2")
w()
w("      - name: Get Composer cache dir")
w("        id: composer-cache")
w("        run: echo \"dir=$(composer config cache-files-dir)\" >> \"$GITHUB_OUTPUT\"")
w()
w("      - uses: actions/cache@v5")
w("        with:")
w("          path: ${{ steps.composer-cache.outputs.dir }}")
w("          key: ${{ runner.os }}-composer-${{ hashFiles('**/composer.lock') }}")
w("          restore-keys: |")
w("            ${{ runner.os }}-composer-")
w()
w("      - name: Install PHP dependencies")
w("        run: composer install --no-interaction --prefer-dist --no-progress")
w()
w("      - name: Prepare application")
w("        run: |")
w("          cp .env.example .env")
w("          php artisan key:generate --force --no-interaction")
w("          mkdir -p database")
w("          touch database/database.sqlite")
w("          php artisan migrate --force --no-interaction")
w()
if php_needs_assets:
    if pm == "pnpm":
        w("      - uses: pnpm/action-setup@v4")
        w("        with:")
        w("          version: 10")
        w()
    w("      - uses: actions/setup-node@v5")
    w("        with:")
    w(f"          node-version: '{node_ver}'")
    if cache_input:
        w(f"          cache: {cache_input}")
    w()
    w("      - name: Install JS dependencies")
    w(f"        run: {pm_install}")
    w()
    w("      - name: Build frontend assets")
    w(f"        run: {pm} run build")
    w()

if has_pint:
    w("      - name: Pint (check)")
    w("        run: vendor/bin/pint --parallel --test")
    w()

if has_phpstan:
    w("      - name: PHPStan")
    w("        run: vendor/bin/phpstan analyse --no-progress")
    w()

if has_rector:
    w("      - name: Rector (dry-run)")
    w("        run: vendor/bin/rector process --dry-run --no-progress-bar")
    w()

w("      - name: PHP tests")
w("        run: php artisan test")
w()

# ---------- JS job ----------
if has_js and (has_format_check or has_lint or has_types or has_test_js or has_build):
    w("  js:")
    w("    name: js")
    w("    runs-on: ubuntu-latest")
    w("    timeout-minutes: 30")
    w()
    w("    steps:")
    w("      - uses: actions/checkout@v5")
    w()
    if needs_php_for_js:
        w("      - uses: shivammathur/setup-php@2.40.0")
        w("        with:")
        w(f"          php-version: '{php_ver}'")
        w("          extensions: mbstring, xml, curl, zip, sqlite3, bcmath, intl")
        w("          coverage: none")
        w("          tools: composer:v2")
        w()
        w("      - name: Get Composer cache dir")
        w("        id: composer-cache")
        w("        run: echo \"dir=$(composer config cache-files-dir)\" >> \"$GITHUB_OUTPUT\"")
        w()
        w("      - uses: actions/cache@v5")
        w("        with:")
        w("          path: ${{ steps.composer-cache.outputs.dir }}")
        w("          key: ${{ runner.os }}-composer-${{ hashFiles('**/composer.lock') }}")
        w("          restore-keys: |")
        w("            ${{ runner.os }}-composer-")
        w()
        w("      - name: Install PHP dependencies")
        w("        run: composer install --no-interaction --prefer-dist --no-progress")
        w()
        w("      - name: Prepare Laravel env (Wayfinder / Vite)")
        w("        run: |")
        w("          cp .env.example .env")
        w("          php artisan key:generate --force --no-interaction")
        w()

    if pm == "pnpm":
        w("      - uses: pnpm/action-setup@v4")
        w("        with:")
        w("          version: 10")
        w()
    w("      - uses: actions/setup-node@v5")
    w("        with:")
    w(f"          node-version: '{node_ver}'")
    if cache_input:
        w(f"          cache: {cache_input}")
    w()
    w("      - name: Install JS dependencies")
    w(f"        run: {pm_install}")
    w()

    if has_format_check:
        w("      - name: Format check")
        w(f"        run: {pm} run format:check")
        w()
    if has_lint:
        w("      - name: Lint")
        w(f"        run: {pm} run lint")
        w()
    if has_types:
        w("      - name: Types")
        w(f"        run: {pm} run types")
        w()
    if has_build:
        w("      - name: Build")
        w(f"        run: {pm} run build")
        w()
    if has_test_js:
        w("      - name: JS tests")
        w(f"        run: {pm} run test:js")
        w()
else:
    # still record why js job omitted via stderr
    print("Skipping js job (no package.json scripts for format/lint/types/test/build)", file=sys.stderr)

out = root / ".github" / "workflows" / "ci.yml"
out.parent.mkdir(parents=True, exist_ok=True)
text = "\n".join(lines).rstrip() + "\n"
out.write_text(text, encoding="utf-8")
print(f"Wrote {out}")
print(
    "Detected:",
    {
        "php": php_ver,
        "node": node_ver,
        "pm": pm,
        "pint": has_pint,
        "phpstan": has_phpstan,
        "rector": has_rector,
        "format:check": has_format_check,
        "lint": has_lint,
        "types": has_types,
        "test:js": has_test_js,
        "build": has_build,
    },
)
PY

ok "CI workflow ready at .github/workflows/ci.yml"
