#!/usr/bin/env bash
# apply-essentials — idempotently apply sensible Laravel defaults into the app's
# existing AppServiceProvider (plus make:action, Pint/Rector stubs, Password::defaults).
#
# Does NOT create EssentialsServiceProvider or register anything in
# bootstrap/providers.php.
#
# Usage:
#   apply-essentials [--dir <app>] [--dry-run]
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SKILL_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
STUBS_DIR="${SKILL_DIR}/reference/stubs"
LIB_DIR="${SCRIPT_DIR}/lib"

APP_DIR="$(pwd)"
DRY_RUN=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dir) APP_DIR="$2"; shift 2 ;;
    --dry-run) DRY_RUN=1; shift ;;
    -h|--help)
      sed -n '2,12p' "$0"
      exit 0
      ;;
    *) echo "Unknown arg: $1" >&2; exit 1 ;;
  esac
done

APP_DIR="$(cd "$APP_DIR" && pwd)"

RED=$'\033[0;31m'; GRN=$'\033[0;32m'; YLW=$'\033[0;33m'; BLU=$'\033[0;34m'; NC=$'\033[0m'
log()  { printf '%s%s%s\n' "$BLU" "$*" "$NC" >&2; }
ok()   { printf '%s%s%s\n' "$GRN" "$*" "$NC" >&2; }
warn() { printf '%s%s%s\n' "$YLW" "$*" "$NC" >&2; }
err()  { printf '%s%s%s\n' "$RED" "$*" "$NC" >&2; }

[[ -f "${APP_DIR}/artisan" ]] || { err "Not a Laravel app: ${APP_DIR}"; exit 1; }

copy_stub() {
  local src="$1"
  local dest="$2"
  if [[ "$DRY_RUN" -eq 1 ]]; then
    log "[dry-run] would copy ${src} -> ${dest}"
    return 0
  fi
  mkdir -p "$(dirname "$dest")"
  cp "$src" "$dest"
}

# Fixed password policy constants (shared with Python helpers).
PASSWORD_MIN=12
PASSWORD_MAX=255

remove_legacy_essentials_provider() {
  local legacy="${APP_DIR}/app/Providers/EssentialsServiceProvider.php"
  local providers_php="${APP_DIR}/bootstrap/providers.php"

  if [[ -f "$legacy" ]]; then
    if [[ "$DRY_RUN" -eq 1 ]]; then
      log "[dry-run] would remove ${legacy}"
    else
      log "Removing legacy EssentialsServiceProvider.php"
      rm -f "$legacy"
    fi
  fi

  if [[ -f "$providers_php" ]] && grep -q 'EssentialsServiceProvider' "$providers_php"; then
    if [[ "$DRY_RUN" -eq 1 ]]; then
      log "[dry-run] would unregister EssentialsServiceProvider from bootstrap/providers.php"
      return 0
    fi
    log "Unregistering EssentialsServiceProvider from bootstrap/providers.php"
    python3 - "$providers_php" <<'PY'
from pathlib import Path
import re
import sys

path = Path(sys.argv[1])
text = path.read_text(encoding="utf-8")
text2 = re.sub(
    r"\n[ \t]*App\\Providers\\EssentialsServiceProvider::class,?[ \t]*",
    "\n",
    text,
)
text2 = re.sub(
    r"(?m)^use\s+App\\Providers\\EssentialsServiceProvider\s*;\s*\n",
    "",
    text2,
)
path.write_text(text2, encoding="utf-8")
PY
  fi
}

patch_app_service_provider() {
  local dest="${APP_DIR}/app/Providers/AppServiceProvider.php"
  if [[ ! -f "$dest" ]]; then
    err "Missing app/Providers/AppServiceProvider.php"
    exit 1
  fi
  if [[ "$DRY_RUN" -eq 1 ]]; then
    log "[dry-run] would merge essentials into ${dest} (Password::min(${PASSWORD_MIN})->max(${PASSWORD_MAX}))"
    return 0
  fi
  log "Merging essentials into app/Providers/AppServiceProvider.php (Password::min(${PASSWORD_MIN})->max(${PASSWORD_MAX}))"
  python3 "${LIB_DIR}/patch_app_service_provider.py" "$dest"
  ok "AppServiceProvider essentials merge done"
}

align_password_surfaces() {
  if [[ "$DRY_RUN" -eq 1 ]]; then
    log "[dry-run] would align password tests, hashing, and UI copy"
    return 0
  fi
  log "Aligning password surfaces (Password::defaults, argon2id)"
  python3 "${LIB_DIR}/align_password_surfaces.py" "$APP_DIR" "$STUBS_DIR"
}

install_make_action() {
  local cmd_dest="${APP_DIR}/app/Console/Commands/MakeActionCommand.php"
  local stub_dest="${APP_DIR}/stubs/action.stub"

  if [[ -f "$cmd_dest" ]]; then
    ok "make:action command already present"
  else
    log "Installing make:action command"
    copy_stub "${STUBS_DIR}/MakeActionCommand.php" "$cmd_dest"
  fi

  if [[ -f "$stub_dest" ]]; then
    ok "action.stub already present"
  else
    log "Installing stubs/action.stub"
    copy_stub "${STUBS_DIR}/action.stub" "$stub_dest"
  fi
}

install_pint() {
  log "Writing pint.json"
  copy_stub "${STUBS_DIR}/pint.json" "${APP_DIR}/pint.json"
}

install_rector() {
  local dest="${APP_DIR}/rector.php"
  if [[ -f "$dest" ]]; then
    ok "rector.php already present (left unchanged)"
    return 0
  fi
  log "Adding rector.php stub"
  copy_stub "${STUBS_DIR}/rector.php" "$dest"
}

fix_profile_validation_phpdoc() {
  local file="${APP_DIR}/app/Concerns/ProfileValidationRules.php"
  [[ -f "$file" ]] || return 0
  if grep -q 'use Illuminate\\Validation\\Rules\\Unique;' "$file" \
    && grep -q '@return array<int, Unique|string>' "$file"; then
    ok "ProfileValidationRules PHPDoc already includes Unique"
    return 0
  fi
  log "Updating ProfileValidationRules PHPDoc for final User + Rule::unique()"
  if [[ "$DRY_RUN" -eq 1 ]]; then
    return 0
  fi
  python3 - "$file" <<'PY'
from pathlib import Path
import re
import sys

path = Path(sys.argv[1])
text = path.read_text(encoding="utf-8")

if "use Illuminate\\Validation\\Rules\\Unique;" not in text:
    text = text.replace(
        "use Illuminate\\Validation\\Rule;",
        "use Illuminate\\Validation\\Rule;\nuse Illuminate\\Validation\\Rules\\Unique;",
        1,
    )

text = text.replace("use Illuminate\\Support\\Stringable;\n", "")
text = text.replace(
    "@return array<string, array<int, ValidationRule|array<mixed>|string>>",
    "@return array<string, array<int, ValidationRule|Unique|array<mixed>|string>>",
)
text = text.replace(
    "@return array<string, array<int, ValidationRule|Stringable|array<mixed>|string>>",
    "@return array<string, array<int, ValidationRule|Unique|array<mixed>|string>>",
)
text = re.sub(
    r"(/\*\*[\s\S]*?@return )array<int, ValidationRule(?:\|Stringable)?(?:\|array<mixed>)?\|string>(\s*\*/\s*protected function emailRules)",
    r"\1array<int, Unique|string>\2",
    text,
    count=1,
)
text = text.replace(
    "@return array<int, ValidationRule|Stringable|array<mixed>|string>",
    "@return array<int, ValidationRule|array<mixed>|string>",
)
path.write_text(text, encoding="utf-8")
PY
  ok "Updated ProfileValidationRules PHPDoc"
}

run_pint_if_available() {
  if [[ -x "${APP_DIR}/vendor/bin/pint" ]]; then
    log "Running Pint (keeps style inside the essentials commit)"
    if [[ "$DRY_RUN" -eq 1 ]]; then
      return 0
    fi
    (cd "$APP_DIR" && vendor/bin/pint --parallel) || warn "Pint reported issues"
  else
    warn "vendor/bin/pint not found — run composer install / Pint after scaffolding"
  fi
}

remove_legacy_essentials_provider
patch_app_service_provider
align_password_surfaces
install_make_action
install_pint
fix_profile_validation_phpdoc
install_rector
run_pint_if_available

ok "Sensible defaults applied in ${APP_DIR}"
cat <<EOF

Applied:
  - app/Providers/AppServiceProvider.php (essentials in boot()/existing helpers; no EssentialsServiceProvider)
  - Passwords follow Password::defaults (min ${PASSWORD_MIN} / max ${PASSWORD_MAX} / uncompromised)
  - HASH_DRIVER=argon2id with explicit Argon costs; rehash_on_login enabled
  - UncompromisedVerifier fake in TestCase (keeps kit auth tests offline)
  - php artisan make:action (+ stubs/action.stub)
  - pint.json (+ Pint when vendor present)
  - rector.php (if missing)

Commit as one atomic essentials commit, then run setup-tooling.
EOF
