# Generated by laravel-new setup-docker — keep secrets and build junk out of the image.
.git
.github
.agents
.agent
.claude
.codex
.cursor
.gemini
.junie
.idea
.vscode

.env
.env.*
!.env.example

node_modules
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

vendor
bootstrap/ssr
# Stale package discovery from the host often references require-dev providers
# (pail, sail, …) that are absent from production --no-dev vendor.
bootstrap/cache/*.php
!bootstrap/cache/.gitignore

storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/testing/*
storage/framework/views/*
!storage/logs/.gitignore
!storage/framework/cache/data/.gitignore
!storage/framework/sessions/.gitignore
!storage/framework/testing/.gitignore
!storage/framework/views/.gitignore

public/build
public/hot
public/storage

database/*.sqlite
database/*.sqlite-journal

.phpunit.result.cache
.phpunit.cache
coverage
dist
tmp
temp

Dockerfile*
docker-compose*.yml
compose*.yml
.dockerignore

README.md
DOCKER.md
AGENTS.md
**/__tests__
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
